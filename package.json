{
  "name": "media-hub",
  "version": "0.1.0",
  "description": "一个人的自媒体工作台：灵感 → 选题 → 创作 → 排期 → 发布 → 复盘，本地 markdown 即数据源",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "gen:data": "node scripts/build-data.mjs",
    "collect": "ego-browser nodejs < scripts/collect-platforms.mjs",
    "predev": "npm run gen:data --silent",
    "dev": "vite",
    "prebuild": "npm run gen:data --silent",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "collect:note": "ego-browser nodejs < scripts/collect-note.mjs",
    "publish:oss": "node scripts/publish-oss.mjs"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}